@{
    ViewData["Title"] = "Upload";
}

<div class="container py-4" style="max-width: 860px;">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-0">Upload document</h2>
            <div class="text-muted small">Allowed: PDF, DOCX, TXT. Max: 100 MB.</div>
        </div>
        <a class="btn btn-outline-secondary" asp-controller="Documents" asp-action="Index">Back</a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">

            <form asp-controller="Documents" asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Choose file</label>
                    <input class="form-control" type="file" name="file"
                           accept=".pdf,.docx,.txt,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain" />
                </div>

                <div class="text-danger">
                    @Html.ValidationSummary(excludePropertyErrors: true)
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Upload</button>
                    <a class="btn btn-outline-secondary" asp-controller="Documents" asp-action="Index">Cancel</a>
                </div>
            </form>

            <hr class="my-4" />

            <div class="alert alert-info mb-0">
                Uploads are processed in the background. Status becomes <strong>Ready</strong> when indexing finishes.
            </div>

        </div>
    </div>

</div>
