@model corporate_dashboards.Models.Document
@{
  ViewData["Title"] = "Document";
}

<div class="row g-4">
  <div class="col-lg-4">
    <div class="card shadow-sm border-0 rounded-4">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between gap-2">
          <div>
            <div class="text-muted small">Document</div>
            <h5 class="fw-bold mb-1">@Model.FileName</h5>
            <div class="text-muted small">@Model.ContentType</div>
          </div>
          <span class="badge @StatusClass(Model.Status)">@Model.Status</span>
        </div>

        <hr class="my-3" />

        <div class="d-flex justify-content-between">
          <div class="text-muted small">Uploaded</div>
          <div class="text-muted small">@Model.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
        </div>

        <div class="d-flex justify-content-between">
          <div class="text-muted small">Chunks</div>
          <div class="text-muted small">@Model.Chunks.Count</div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
          <div class="alert alert-danger mt-3 mb-0">@Model.ErrorMessage</div>
        }

        <form class="mt-3" asp-action="Reprocess" method="post">
          @Html.AntiForgeryToken()
          <input type="hidden" name="id" value="@Model.Id" />
          <button class="btn btn-outline-secondary rounded-3" type="submit">Reprocess</button>
        </form>

        <div class="mt-3">
          <a class="btn btn-primary rounded-3 w-100" asp-controller="Chat" asp-action="Index">Ask</a>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card shadow-sm border-0 rounded-4">
      <div class="card-body p-4">
        <h5 class="fw-bold mb-3">Chunks (first 50)</h5>

        @if (Model.Chunks.Count == 0)
        {
          <div class="text-muted">No chunks yet (or embeddings failed). Check Ollama embedding model.</div>
        }
        else
        {
          foreach (var c in Model.Chunks.OrderBy(x => x.Id).Take(50))
          {
            <div class="chunk mb-3">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="fw-semibold">@c.SourceLabel</div>
                <span class="text-muted small">#@c.Id</span>
              </div>
              <div class="text-muted small prewrap">@Trim(c.Text, 900)</div>
            </div>
          }
        }
      </div>
    </div>
  </div>
</div>

@functions{
  string Trim(string s, int n) => string.IsNullOrEmpty(s) ? "" : (s.Length <= n ? s : s.Substring(0, n) + "…");

  string StatusClass(string s) => s switch
  {
    "Ready" => "text-bg-success",
    "Queued" => "text-bg-secondary",
    "Processing" => "text-bg-warning",
    "Failed" => "text-bg-danger",
    _ => "text-bg-light"
  };
}
