@{
    string currentPath = (Context.Request.Path.Value ?? "").TrimEnd('/');

    bool Active(string pathPrefix)
    {
        return currentPath.StartsWith(pathPrefix.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
    }

    string active(string pathPrefix) => Active(pathPrefix) ? " active" : "";
}

