<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DocChat</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
</head>

@{
    var ctrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "");
    var act = (ViewContext.RouteData.Values["action"]?.ToString() ?? "");

    var suiteNavQuery = (Context.Request.Query["suiteNav"].ToString() ?? "").Trim();
    var layoutTitleQuery = (Context.Request.Query["layoutTitle"].ToString() ?? "").Trim();

    var bodyOnly =
        string.Equals(Context.Request.Query["bodyOnly"], "1", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Context.Request.Query["embed"], "1", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Context.Request.Query["chromeless"], "1", StringComparison.OrdinalIgnoreCase);

    /*
        Hardcoded external-suite route.
        This lets /Dashboard/Multi render with the suite nav and hide local DocChat chrome
        even if query forwarding is inconsistent.
    */
    var forceAgingSuiteNav =
        ctrl.Equals("Dashboard", StringComparison.OrdinalIgnoreCase)
        && act.Equals("Multi", StringComparison.OrdinalIgnoreCase)
        && (
            string.Equals(layoutTitleQuery, "AR Dashboard", StringComparison.OrdinalIgnoreCase)
            || string.Equals(suiteNavQuery, "aging_desk_app", StringComparison.OrdinalIgnoreCase)
        );

    var showAgingSuiteNav =
        !bodyOnly
        && (
            forceAgingSuiteNav
            || string.Equals(suiteNavQuery, "aging_desk_app", StringComparison.OrdinalIgnoreCase)
        );

    var showLocalChrome =
        !bodyOnly
        && !showAgingSuiteNav;

    var showTopbar =
        showLocalChrome
        && ctrl.Equals("Dashboard", StringComparison.OrdinalIgnoreCase)
        && act.Equals("Index", StringComparison.OrdinalIgnoreCase);

    var mainClass = showAgingSuiteNav
        ? "container-fluid px-3 py-3"
        : "container-fluid px-4 py-4";
}

<body class="@(bodyOnly ? "body-only" : showAgingSuiteNav ? "suite-nav-mode" : "")">

    @if (showAgingSuiteNav)
    {
        @await Html.PartialAsync("_SuiteAgingNav")
    }

    @if (showLocalChrome)
    {
        <div class="user-pill">
            <i class="fa-solid fa-user"></i>
            <span>
                @(User?.Identity?.IsAuthenticated == true ? (User.Identity?.Name ?? "User") : "Guest")
            </span>
        </div>

        @if (showTopbar)
        {
            <header class="topbar shadow-sm">
                <div class="container-fluid px-4">
                    <div class="d-flex align-items-center justify-content-between" style="height:56px;">
                        <div class="d-flex align-items-center gap-3">
                            <a class="brand" asp-controller="Home" asp-action="Index">DocChat</a>
                            <span class="badge text-bg-light border">Local Llama RAG</span>
                        </div>

                        <nav class="d-flex align-items-center gap-2">
                            <a class="navlink" asp-controller="Documents" asp-action="Index">Documents</a>
                            <a class="navlink" asp-controller="Chat" asp-action="Index">Ask</a>
                        </nav>
                    </div>
                </div>
            </header>
        }
    }

    @if (bodyOnly)
    {
        @RenderBody()
    }
    else
    {
        <main class="@mainClass">
            @RenderBody()
        </main>
    }

    @if (showLocalChrome && showTopbar)
    {
        <footer class="footer">
            <div class="container-fluid px-4 py-3 text-muted small">
                Ollama chat model is a parameter per question.
            </div>
        </footer>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <script src="~/js/echarts-theme.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>