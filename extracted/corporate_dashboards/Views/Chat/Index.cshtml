@{
  ViewData["Title"] = "Ask";
  var defaultChat = (string)(ViewBag.DefaultChatModel ?? "");
  var defaultEmb = (string)(ViewBag.DefaultEmbeddingModel ?? "");
}

<div class="row g-4">
  <div class="col-lg-7">
    <div class="card shadow-sm border-0 rounded-4">
      <div class="card-body p-4 p-lg-5">
        <h3 class="fw-bold mb-2">Ask your documents</h3>
        <p class="text-muted mb-4">Chat model (Llama) is a parameter. Embedding model can be overridden too.</p>

        <form asp-action="Ask" asp-controller="Chat" method="post">
          <div class="mb-3">
            <label class="form-label">Question</label>
            <textarea class="form-control" name="question" rows="4" placeholder="Ask something specific..." required></textarea>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Chat model (Llama)</label>
              <input class="form-control" name="chatModel" value="@defaultChat" placeholder="e.g., llama3.1" />
              <div class="form-text">Used for answering.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label">Embedding model</label>
              <input class="form-control" name="embeddingModel" value="@defaultEmb" placeholder="e.g., nomic-embed-text" />
              <div class="form-text">Used for retrieval.</div>
            </div>
          </div>

          <button class="btn btn-primary btn-lg rounded-3 mt-4" type="submit">Ask</button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card shadow-sm border-0 rounded-4">
      <div class="card-body p-4">
        <h6 class="fw-semibold mb-2">Notes</h6>
        <ul class="text-muted mb-0">
          <li>Make sure your embedding model is installed in Ollama.</li>
          <li>Text-only PDFs work best; scanned PDFs need OCR (not included in this base build).</li>
        </ul>
      </div>
    </div>
  </div>
</div>
