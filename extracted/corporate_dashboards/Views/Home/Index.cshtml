@{
  ViewData["Title"] = "Home";
}

<div class="row g-4">
  <div class="col-lg-7">
    <div class="card shadow-sm border-0 rounded-4">
      <div class="card-body p-4 p-lg-5">
        <h1 class="display-6 fw-bold mb-2">Upload documents, then ask questions.</h1>
        <p class="text-muted mb-4">
          Extracts PDF/DOCX/TXT, chunks it, creates embeddings via your local Ollama server,
          retrieves relevant chunks, then answers using a Llama model you choose.
        </p>

        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-primary btn-lg rounded-3" asp-controller="Documents" asp-action="Index">Upload docs</a>
          <a class="btn btn-outline-secondary btn-lg rounded-3" asp-controller="Chat" asp-action="Index">Ask</a>
        </div>

        <hr class="my-4" />

        <div class="row g-3">
          <div class="col-md-6"><div class="mini-card"><div class="mini-title">Llama as parameter</div><div class="mini-text">Override chat model per question.</div></div></div>
          <div class="col-md-6"><div class="mini-card"><div class="mini-title">Citations</div><div class="mini-text">Answers cite <span class="badge text-bg-light border">[Source 1]</span> chunks.</div></div></div>
          <div class="col-md-6"><div class="mini-card"><div class="mini-title">Background indexing</div><div class="mini-text">Uploads queue + process asynchronously.</div></div></div>
          <div class="col-md-6"><div class="mini-card"><div class="mini-title">SQLite storage</div><div class="mini-text">Embeddings stored as JSON float arrays.</div></div></div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card shadow-sm border-0 rounded-4">
      <div class="card-body p-4">
        <h5 class="fw-semibold mb-3">Quick start</h5>
        <ol class="text-muted mb-0">
          <li>Run Ollama locally.</li>
          <li>Pull a chat model (e.g., llama3.1) and an embedding model (e.g., nomic-embed-text).</li>
          <li>Run this app, upload docs, then ask.</li>
        </ol>
      </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 mt-4">
      <div class="card-body p-4">
        <h6 class="fw-semibold mb-2">Config</h6>
        <div class="codebox">appsettings.json → Ollama:BaseUrl, ChatModel, EmbeddingModel</div>
        <div class="text-muted small mt-2">You can override model names per question.</div>
      </div>
    </div>
  </div>
</div>
