        function formatSnapshotShort(v) {
        if (!v) return '';
        const d = new Date(v);
        if (Number.isNaN(d.getTime())) return String(v);

        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const dd = String(d.getDate()).padStart(2, '0');
        const hh = String(d.getHours()).padStart(2, '0');
        const mi = String(d.getMinutes()).padStart(2, '0');
        const ss = String(d.getSeconds()).padStart(2, '0');

        return `${mm}-${dd} ${hh}:${mi}:${ss}`;
        }

        function formatVersionDate(v) {
        const raw = v?.createdUtc || v?.createdAt || v?.created || v?.createdOn || "";
        if (!raw) return "";
        const d = new Date(raw);
        if (Number.isNaN(d.getTime())) return String(raw);
        return d.toLocaleString();
        }

        function buildCustomHtmlModel(ctx) {
        const rows = Array.isArray(ctx.data) ? ctx.data.filter(Boolean) : [];
        const valueFields = ctx.valueFields || [];

        function tsKey(row) {
        const raw = row?.snapshot_time ?? row?.start_time ?? row?.inserted_at ?? '';
        if (!raw) return '';

        return String(raw)
        .trim()
        .replace('T', ' ')
        .replace('Z', '')
        .replace(/\.\d+$/, '')
        .replace(/[^0-9]/g, '')
        .padEnd(14, '0');
        }

        function formatSnapshotShort(v) {
        if (!v) return '';
        const d = new Date(v);
        if (Number.isNaN(d.getTime())) return String(v);

        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const dd = String(d.getDate()).padStart(2, '0');
        const hh = String(d.getHours()).padStart(2, '0');
        const mi = String(d.getMinutes()).padStart(2, '0');
        const ss = String(d.getSeconds()).padStart(2, '0');

        return `${mm}-${dd} ${hh}:${mi}:${ss}`;
        }

        const latest = rows.length
        ? rows.slice().sort((a, b) => tsKey(b).localeCompare(tsKey(a)))[0]
        : {};

        let total = 0;
        for (const row of rows) {
        const v = Number(row?.[valueFields[0] || '']);
        if (Number.isFinite(v)) total += v;
        }

        return {
        ...latest,
        snapshot_time: formatSnapshotShort(latest.snapshot_time || latest.start_time || latest.inserted_at || ''),
        remote_server: latest.remote_server || latest.server_name || '',
        remote_database: latest.remote_database || latest.database_name || '',
        health_score: Number(latest.health_score ?? total ?? 0),
        health_status: latest.health_status || ctx.res?.agg || 'Snapshot',
        blocker_sessions: Number(latest.blocker_sessions || 0),
