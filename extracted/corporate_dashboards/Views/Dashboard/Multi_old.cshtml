        saveModal.classList.add("d-none");
        await loadHistory(); await restoreByIndex(versions.length - 1);
        } catch (e) { alert("Save failed: " + (e.message || e)); }
        };

        // ── History helpers ──
        const loadHistory = async () => {
        const url = new URL(endpoints.layoutHistory, window.location.origin); url.searchParams.set("page", PAGE); url.searchParams.set("take", "500");
        const out = await apiGet(url.toString());
        const list = Array.isArray(out?.versions) ? out.versions : [];
        versions = list.slice().sort((a, b) => (Number(a.versionNo || 0) - Number(b.versionNo || 0)) || (Number(a.id || 0) - Number(b.id || 0)));
        if (verIx >= versions.length) verIx = Math.max(versions.length - 1, 0);
        };
        const getCurrentId = async () => { const url = new URL(endpoints.layoutGetCurrent, window.location.origin); url.searchParams.set("page", PAGE); const out = await apiGet(url.toString()); const id = out?.currentVersionId; return (typeof id === "number" && isFinite(id) && id > 0) ? id : null; };
        const setCurrentId = async id => { try { await apiPost(endpoints.layoutSetCurrent, { page: PAGE, currentVersionId: id }); } catch { } };
        const fetchPayloadById = async id => { const url = new URL(endpoints.layoutGet, window.location.origin); url.searchParams.set("id", String(id)); const out = await apiGet(url.toString()); return out?.layoutJson ?? out?.layout ?? out; };

        const restoreFromPayload = async payload => {
        window.__dashRestoringLayout = true;
        try {
        const isArr = Array.isArray(payload);
        const nodesRaw = isArr ? payload : (payload?.grid ?? payload?.layout ?? payload?.layoutJson ?? []);
        const tiles = (!isArr && payload?.tiles) ? payload.tiles : null;
        const nodes = (Array.isArray(nodesRaw) ? nodesRaw : []).map(normNode);
        grid.removeAll(true); tileSeq = 0;
        if (!nodes.length) { await addTile(grid, schemas, connections, { w: 6, h: 7 }); return; }
        window.__dashRestoreMode = true;
        let maxIdNum = 0;
        const sorted = nodes.slice().sort((a, b) => (Number(a.y ?? 0) - Number(b.y ?? 0)) || (Number(a.x ?? 0) - Number(b.x ?? 0)));
        const created = [];
        for (const n of sorted) {
        const id = String(n.id ?? uid()); const x = Number(n.x ?? 0), y = Number(n.y ?? 0), w = Number(n.w ?? 6), h = Number(n.h ?? 7);
        const snap = (tiles && tiles[id]) ? tiles[id] : null;
