        try { const widget = tileRoot.closest(".grid-stack-item"); if (widget) grid.update(widget, { x, y, w, h, minW: 1, minH: 1 }); } catch { }
        const idNum = parseInt(id, 10); if (Number.isFinite(idNum)) maxIdNum = Math.max(maxIdNum, idNum);
        created.push({ tileRoot, snap, node: n }); maxIdNum = Math.max(maxIdNum, Number.isFinite(idNum) ? idNum : 0);
