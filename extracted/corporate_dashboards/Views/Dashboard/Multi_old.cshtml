        if (__dragFromZone === "cols") s.pivot.cols = s.pivot.cols.filter(x => x.toLowerCase() !== field.toLowerCase());
        if (__dragFromZone === "vals") s.pivot.vals = s.pivot.vals.filter(x => x.toLowerCase() !== field.toLowerCase());
