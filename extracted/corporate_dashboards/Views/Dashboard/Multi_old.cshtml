        verKpi.addEventListener("click", openBrowse);
        // < > also open browse for context (in addition to navigating)
        btnPrev.addEventListener("click", async () => { if (verIx <= 0) return; await restoreByIndex(verIx - 1); });
        btnNext.addEventListener("click", async () => { if (verIx >= versions.length - 1) return; await restoreByIndex(verIx + 1); });

        // ── Save modal ──
        const saveModal = document.getElementById("saveVerModal");
        const saveName = document.getElementById("saveVerName"), saveFav = document.getElementById("saveVerFav");
