        try {
        await apiPost(endpoints.layoutDelete, { id: v.id });
        await loadHistory();
        if (verIx >= versions.length) verIx = Math.max(0, versions.length - 1);
        if (versions.length) await restoreByIndex(verIx);
        renderBrowseList(); updateVerUi();
        } catch (err) { alert("Delete failed: " + (err.message || err)); }
        });
