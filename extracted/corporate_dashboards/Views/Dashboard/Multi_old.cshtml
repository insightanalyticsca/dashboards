        async function loadRemoteHealthTrend(ctx, liveModel, config = {}) {
        function tsKey(row) {
        const raw = row?.snapshot_time ?? row?.start_time ?? row?.inserted_at ?? '';
        if (!raw) return '';

        return String(raw)
        .trim()
        .replace('T', ' ')
        .replace('Z', '')
        .replace(/\.\d+$/, '')
        .replace(/[^0-9]/g, '')
        .padEnd(14, '0');
        }

        function formatTrendLabel(v) {
        if (!v) return '';
        const d = new Date(v);
        if (Number.isNaN(d.getTime())) return String(v);

        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const dd = String(d.getDate()).padStart(2, '0');
        const hh = String(d.getHours()).padStart(2, '0');
        const mi = String(d.getMinutes()).padStart(2, '0');

        return `${mm}-${dd} ${hh}:${mi}`;
        }

        const trendSchema = String(config?.trendSchema || 'its').trim();
        const trendObject = String(config?.trendObject || 'vw_RemoteDbHealth_history').trim();
        const trendTimeField = String(config?.trendTimeField || 'snapshot_time').trim();
        const trendValueField = String(config?.trendValueField || 'health_score').trim();
        const trendMaxPoints = Math.max(2, Number(config?.trendMaxPoints || 12) || 12);

        const req = {
        connectionName: ctx.tileRoot?._state?.dataset?.connection || "build",
        schema: trendSchema,
        obj: trendObject,
        rows: [trendTimeField],
        cols: [],
        values: [trendValueField],
        agg: 'Maximum',
        dateGroups: {},
        filters: {
        remote_server: {
        mode: 'in',
        values: liveModel.remote_server ? [liveModel.remote_server] : [],
        fromUtc: null,
        toUtc: null
        },
        remote_database: {
        mode: 'in',
        values: liveModel.remote_database ? [liveModel.remote_database] : [],
        fromUtc: null,
        toUtc: null
        }
        },
        maxCells: 50000
        };

        const out = await apiPost(endpoints.aggregate, req);
        const rows = Array.isArray(out?.data) ? out.data.filter(Boolean) : [];
        const trendRows = rows.slice().sort((a, b) => tsKey(a).localeCompare(tsKey(b)));
        const lastPoints = trendRows.slice(-trendMaxPoints);

        return {
        score_history: lastPoints
        .map(r => Number(r?.[trendValueField]))
        .filter(v => Number.isFinite(v)),
        score_labels: lastPoints.map(r =>
        formatTrendLabel(r?.[trendTimeField] || r?.snapshot_time || r?.start_time || r?.inserted_at || '')
        )
        };
        }

        async function fetchCustomHtmlLiveModel(ctx, config = {}) {
        if (isRemoteHealthPayloadMode(config)) {
        return await fetchRemoteHealthLiveModel(ctx, config);
        }

        if (isAgingForecastPayloadMode(config)) {
        return await fetchAgingForecastLiveModel(ctx, config);
        }

        const mode = String(config?.payloadMode || "").trim().toLowerCase();
        const connectionName = String(config?.connectionName || ctx.tileRoot?._state?.dataset?.connection || getEl(ctx.tileRoot, "connection")?.value || "build").trim() || "build";
        const schema = String(config?.schema || ctx?.res?.schema || ctx.tileRoot?._state?.dataset?.schema || "").trim();
        const obj = String(config?.object || config?.obj || ctx?.res?.obj || ctx.tileRoot?._state?.dataset?.obj || "").trim();
        const templateId = String(config?.templateId || config?.key || ctx?.tileRoot?._state?.customHtmlTemplate || "").trim();
        const role = String(config?.role || "").trim();

        const normalizeResult = (res, req) => {
        const data = Array.isArray(res?.data) ? res.data.filter(Boolean) : [];
        const nextCtx = {
        ...ctx,
        res: {
        ...res,
        schema: req.schema,
        obj: req.obj,
        templateId,
        role,
        connectionName: req.connectionName
        },
        data,
        rowFields: Array.isArray(res?.rowFields) ? res.rowFields : (req.rows || []),
        colFields: Array.isArray(res?.colFields) ? res.colFields : (req.cols || []),
        valueFields: Array.isArray(res?.valueFields) ? res.valueFields : (req.values || [])
        };
        const model = buildCustomHtmlModel(nextCtx);
        return { ctx: nextCtx, model };
        };

        if (mode === "rawrows" || mode === "templateaggregate" || mode === "sdprequests") {
        const isPassthroughMode = mode === "rawrows" || mode === "sdprequests";
        const req = {
        connectionName,
        schema,
        obj,
        payloadMode: mode === "sdprequests" ? "sdpRequests" : (mode === "rawrows" ? "rawRows" : "templateAggregate"),
        templateId,
        role,
        trendSchema: String(config?.trendSchema || "").trim(),
        trendObject: String(config?.trendObject || "").trim(),
        trendDatabase: String(config?.trendDatabase || "").trim(),
        trendTimeField: String(config?.trendTimeField || "").trim(),
        trendValueField: String(config?.trendValueField || "").trim(),
        trendMaxPoints: Math.max(2, Number(config?.trendMaxPoints || 12) || 12),
        summarySchema: String(config?.summarySchema || "").trim(),
        summaryObject: String(config?.summaryObject || "").trim(),
        summaryDatabase: String(config?.summaryDatabase || "").trim(),
        pointsSchema: String(config?.pointsSchema || "").trim(),
        pointsObject: String(config?.pointsObject || "").trim(),
        pointsDatabase: String(config?.pointsDatabase || "").trim(),
        defaultMode: String(config?.defaultMode || "").trim(),
        normalPointsSchema: String(config?.normalPointsSchema || "").trim(),
        normalPointsObject: String(config?.normalPointsObject || "").trim(),
        normalPointsDatabase: String(config?.normalPointsDatabase || "").trim(),
        normalSummarySchema: String(config?.normalSummarySchema || "").trim(),
        normalSummaryObject: String(config?.normalSummaryObject || "").trim(),
        normalSummaryDatabase: String(config?.normalSummaryDatabase || "").trim(),
        fastPointsSchema: String(config?.fastPointsSchema || "").trim(),
        fastPointsObject: String(config?.fastPointsObject || "").trim(),
        fastPointsDatabase: String(config?.fastPointsDatabase || "").trim(),
        fastSummarySchema: String(config?.fastSummarySchema || "").trim(),
        fastSummaryObject: String(config?.fastSummaryObject || "").trim(),
        fastSummaryDatabase: String(config?.fastSummaryDatabase || "").trim(),
        rows: isPassthroughMode ? [] : (Array.isArray(config?.rowFields) ? config.rowFields.filter(Boolean) : []),
        cols: isPassthroughMode ? [] : (Array.isArray(config?.colFields) ? config.colFields.filter(Boolean) : []),
        values: isPassthroughMode ? [] : (String(config?.agg || "Sum").toLowerCase() === "count" ? [] : (Array.isArray(config?.valueFields) ? config.valueFields.filter(Boolean) : [])),
        agg: isPassthroughMode ? "Sum" : (config?.agg || "Sum"),
        dateGroups: { ...(config?.dateGroups || {}) },
        filters: { ...(config?.filters || {}), ...getSharedFilters(ctx.tileRoot) },
        maxCells: Number(getEl(ctx.tileRoot, "maxCells")?.value || 50000) || 50000
        };

        if (!req.schema || !req.obj) throw new Error("HTML template has no SQL source configured.");

        try {
        const res = await apiPost(endpoints.customHtmlLive, req);
        return normalizeResult(res, req);
        } catch (liveErr) {
        const detail = liveErr?.message || String(liveErr || "custom html live failed");
        throw new Error(`Template live data failed for ${req.connectionName}:${req.schema}.${req.obj} [${req.payloadMode}] template=${templateId}: ${detail}`);
        }
        }

        const req = buildAggRequest(ctx.tileRoot);
        if (config?.schema && (config?.object || config?.obj)) {
        req.schema = config.schema;
        req.obj = config.object || config.obj;
        }
        if (Array.isArray(config?.rowFields)) req.rows = config.rowFields.filter(Boolean);
        if (Array.isArray(config?.colFields)) req.cols = config.colFields.filter(Boolean);
        if (Array.isArray(config?.valueFields)) req.values = String(config?.agg || req.agg).toLowerCase() === "count" ? [] : config.valueFields.filter(Boolean);
        if (config?.agg) req.agg = config.agg;

        const res = await apiPost(endpoints.aggregate, req);
        return normalizeResult(res, req);
        }

        const __customHtmlDataQueue = [];
        let __customHtmlDataActive = false;

        function queueCustomHtmlDataFetch(fn) {
        return new Promise((resolve, reject) => {
        __customHtmlDataQueue.push({ fn, resolve, reject });
        drainCustomHtmlDataQueue();
        });
        }

        async function drainCustomHtmlDataQueue() {
        if (__customHtmlDataActive) return;

        __customHtmlDataActive = true;

        try {
        while (__customHtmlDataQueue.length) {
        const job = __customHtmlDataQueue.shift();

        try {
        const result = await job.fn();
        job.resolve(result);
        } catch (e) {
        job.reject(e);
        }

        await new Promise(resolve => setTimeout(resolve, 150));
        }
        } finally {
        __customHtmlDataActive = false;
        }
        }

        function renderCustomHtml(ctx) {
        const host = document.createElement('div');
        host.className = 'custom-html-host';
        host.style.width = '100%';
        host.style.height = '100%';
        host.style.minHeight = '100%';
        ctx.chartWrap.appendChild(host);

        clearCustomHtmlRefresh(ctx.tileRoot);

        const renderConfiguredHtml = async () => {
        const resolvedConfig = await resolveCustomHtmlConfig(ctx).catch(() => ({ found: false }));
        const config = resolvedConfig?.found ? resolvedConfig : null;
        const fallbackModel = buildCustomHtmlModel(ctx);

        if (!config?.found || !config?.htmlUrl) {
        host.innerHTML = emptyHtml("No appsettings custom HTML template is configured for this visual.");
        return;
        }

        host.innerHTML = '';
        const frame = document.createElement('iframe');
        frame.className = 'custom-html-frame';
        frame.style.width = '100%';
        frame.style.height = '100%';
        frame.style.minHeight = '100%';
        frame.style.border = '0';
        frame.style.background = 'transparent';
        frame.setAttribute('loading', 'eager');
        frame.setAttribute('referrerpolicy', 'same-origin');
        if (config.inlineHtml) {
        frame.srcdoc = config.inlineHtml;
        } else {
        frame.src = appUrl(config.htmlUrl);
        }
        host.appendChild(frame);

        const waitForLoad = new Promise((resolve, reject) => {
        const onLoad = () => resolve();
        const onError = () => reject(new Error('Custom HTML frame failed to load'));
        frame.addEventListener('load', onLoad, { once: true });
        frame.addEventListener('error', onError, { once: true });
        });

        const postPayload = (type, payloadCtx, model) => {
        if (!frame.contentWindow) return;
        frame.contentWindow.postMessage(
        buildCustomHtmlPayload(payloadCtx, model, config, type),
        window.location.origin
        );
        };

        const postResize = () => {
        if (!frame.contentWindow) return;
        frame.contentWindow.postMessage({
        type: 'dashboard-custom-html:resize',
        payload: {
        width: host.clientWidth || 0,
        height: host.clientHeight || 0
        }
        }, window.location.origin);
        };

        await waitForLoad;

        let initial;
        try {
        initial = await queueCustomHtmlDataFetch(() => fetchCustomHtmlLiveModel(ctx, config));
        setStatus(ctx.tileRoot, "");
        } catch (err) {
        console.warn("Custom HTML template data fetch failed", err);
        setStatus(ctx.tileRoot, "template loaded; data query failed");
        const fallbackCtx = {
        ...ctx,
        res: {
        ...(ctx?.res || {}),
        schema: config.schema || ctx?.res?.schema || "",
        obj: config.obj || ctx?.res?.obj || "",
        data: [],
        rowFields: config.rowFields || [],
        colFields: config.colFields || [],
        valueFields: config.valueFields || [],
        templateId: config.templateId || config.key || ""
        },
        data: [],
        rowFields: config.rowFields || [],
        colFields: config.colFields || [],
        valueFields: config.valueFields || []
        };
        initial = {
        ctx: fallbackCtx,
        model: {
        title: config.title || config.role || "Custom HTML",
        templateId: config.templateId || config.key || "",
        rows: [],
        data: [],
        error: String(err?.message || err || "data query failed")
        }
        };
        }
        ctx.tileRoot._state.lastResult = initial.ctx.res;
        postPayload('dashboard-custom-html:init', initial.ctx, initial.model);
        postResize();

        if (typeof ResizeObserver !== 'undefined') {
        const ro = new ResizeObserver(() => postResize());
        ro.observe(host);
        ctx.tileRoot._customHtmlResizeObserver = ro;
        }

        const scheduleRefresh = () => {
        const refreshSeconds = Math.max(0, Number(config?.refreshSeconds || 0) || 0);
        if (refreshSeconds <= 0) return;

        ctx.tileRoot._customHtmlRefreshHandle = setTimeout(async () => {
        try {
        if (!document.body.contains(ctx.tileRoot)) {
        clearCustomHtmlRefresh(ctx.tileRoot);
        return;
        }

        const refreshed = await queueCustomHtmlDataFetch(() => fetchCustomHtmlLiveModel(ctx, config));
        ctx.tileRoot._state.lastResult = refreshed.ctx.res;
        postPayload('dashboard-custom-html:update', refreshed.ctx, refreshed.model);
        postResize();
        } catch (err) {
        console.warn("Custom HTML live refresh failed", err);
        } finally {
        scheduleRefresh();
        }
        }, refreshSeconds * 1000);
        };

        scheduleRefresh();
        };

        host.innerHTML = '<div class="empty">Loading custom HTML…</div>';
        renderConfiguredHtml().catch(err => {
        console.warn("Custom HTML load failed", err);
        const selectedTemplateId = String(ctx?.tileRoot?._state?.customHtmlTemplate || "").trim();
        host.innerHTML = emptyHtml(`Custom HTML template failed to load: ${esc(err?.message || err || "unknown error")}`);
        });
        }


        async function apiGet(url) {
        const r = await fetch(url, { method: 'GET' });
        if (!r.ok) throw new Error(await r.text() || `GET failed ${r.status}`);
        return await r.json();
        }
        function antiforgeryToken() {
        const el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : null;
        }
        async function apiPost(url, body) {
        const t = antiforgeryToken();
        const r = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', ...(t ? { 'RequestVerificationToken': t } : {}) },
        body: JSON.stringify(body)
        });
        if (!r.ok) throw new Error(await r.text() || `POST failed ${r.status}`);
        return await r.json();
        }
        async function apiDelete(url, body) {
        const t = antiforgeryToken();
        const r = await fetch(url, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json', ...(t ? { 'RequestVerificationToken': t } : {}) },
        body: JSON.stringify(body)
        });
        if (!r.ok) throw new Error(await r.text() || `DELETE failed ${r.status}`);
        return await r.json();
        }
        function debounce(fn, ms) { let t = null; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; }
        function getEl(root, name) {
        const el = root.querySelector(`[data-el="${name}"]`);
        if (!el) throw new Error(`Missing element: ${name}`);
        return el;
        }

        function clearTileAutoRefresh(tileRoot) {
        if (!tileRoot) return;

        if (tileRoot._autoRefreshHandle) {
        clearTimeout(tileRoot._autoRefreshHandle);
        tileRoot._autoRefreshHandle = null;
        }

        tileRoot._autoRefreshBusy = false;
        }

        function clearCustomHtmlRefresh(tileRoot) {
        if (!tileRoot) return;
        if (tileRoot._customHtmlRefreshHandle) {
        clearTimeout(tileRoot._customHtmlRefreshHandle);
        tileRoot._customHtmlRefreshHandle = null;
        }
        if (tileRoot._customHtmlRefreshAbort) {
        try { tileRoot._customHtmlRefreshAbort.abort(); } catch (_) { }
        tileRoot._customHtmlRefreshAbort = null;
        }
        if (tileRoot._customHtmlResizeObserver) {
        try { tileRoot._customHtmlResizeObserver.disconnect(); } catch (_) { }
        tileRoot._customHtmlResizeObserver = null;
        }
        }

        function armTileAutoRefresh(tileRoot) {
        if (!tileRoot) return;

        clearTileAutoRefresh(tileRoot);

        const s = tileRoot._state || {};
        const enabled = !!getEl(tileRoot, "auto").checked;
        const sec = Number(getEl(tileRoot, "autoRefreshSeconds")?.value || s.autoRefreshSeconds || 0);

        s.autoRefreshSeconds = Number.isFinite(sec) ? Math.max(0, sec) : 0;

        if (!enabled || !Number.isFinite(sec) || sec <= 0) return;

        tileRoot._autoRefreshHandle = setTimeout(async () => {
        try {
        if (!document.body.contains(tileRoot)) {
        clearTileAutoRefresh(tileRoot);
        return;
        }

        if (tileRoot._autoRefreshBusy) return;
        tileRoot._autoRefreshBusy = true;

        await runAggregate(tileRoot);
        } catch (e) {
        console.error("Tile auto-refresh failed", e);
        } finally {
        tileRoot._autoRefreshBusy = false;
        armTileAutoRefresh(tileRoot);
        }
        }, sec * 1000);
        }

        // -----------------------------
        // Formatting
        // -----------------------------
        const __nf2 = new Intl.NumberFormat(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        function isFiniteNumber(v) {
        if (v === null || v === undefined) return false;
        if (typeof v === "number") return Number.isFinite(v);
        const s = String(v).trim(); if (!s) return false;
        return Number.isFinite(Number(s));
        }
        function fmt2(v) {
        const n = (typeof v === "number") ? v : Number(String(v).trim());
        return Number.isFinite(n) ? __nf2.format(n) : String(v ?? "");
        }
        function fmtAbbrev(n) {
        const v = Number(n); if (!isFinite(v)) return String(n ?? "");
        const abs = Math.abs(v);
        const trim = s => s.replace(/\.00$/, "").replace(/(\.\d)0$/, "$1");
        if (abs >= 1e12) return trim((v / 1e12).toFixed(2)) + "T";
        if (abs >= 1e9) return trim((v / 1e9).toFixed(2)) + "B";
        if (abs >= 1e6) return trim((v / 1e6).toFixed(2)) + "M";
        if (abs >= 1e3) return trim((v / 1e3).toFixed(2)) + "K";
        return trim(v.toFixed(2));
        }
        function fmtCell(v) {
        if (v === null || v === undefined) return "";
        return isFiniteNumber(v) ? fmt2(v) : String(v);
        }

