        }
        if (by.size > 1 && total > 0) {
        const top = [...by.entries()].sort((a, b) => (b[1] || 0) - (a[1] || 0))[0];
        const share = (top[1] / total) * 100;
        chips.push({
        cls: "good",
        text: `Top ${top[0]} • ${fmt2(share)}%`,
        focusName: top[0],
        filterField: ctx.primaryDim,
        filterValue: top[0]
        });
        }
        }

        // biggest adjacent spike (only for 1 date dim, 1 value, no columns)
        if (ctx.primaryDim && ctx.rowFields?.length === 1 && ctx.colFields?.length === 0 && (ctx.valueFields?.length || 0) === 1) {
        const meta = s?.byName?.[ctx.primaryDim];
        if (meta?.category === "date") {
        const pts = [];
        for (const r of (ctx.data || [])) {
        const d = dashParseDateLike(r?.[ctx.primaryDim]);
        const v = Number(r?.[vf0]);
        if (!d || !Number.isFinite(v)) continue;
        pts.push({ d, label: String(r?.[ctx.primaryDim]), v });
        }
        pts.sort((a, b) => a.d - b.d);
        let best = null;
        for (let i = 1; i < pts.length; i++) {
        const prev = pts[i - 1].v;
        const cur = pts[i].v;
        if (!Number.isFinite(prev) || prev === 0) continue;
        const pct = ((cur - prev) / Math.abs(prev)) * 100;
        if (!Number.isFinite(pct)) continue;
        if (!best || pct > best.pct) best = { pct, label: pts[i].label };
        }
        if (best && best.pct > 15) {
        chips.push({
        cls: best.pct >= 35 ? "warn" : "info",
        text: `Spike +${fmt2(best.pct)}% • ${best.label}`,
        focusName: best.label
        });
        }
        }
        }

        return chips.slice(0, 4);
        }

        function dashRenderInsights(tileRoot, ctx, chips) {
        const row = dashEnsureInsightsRow(tileRoot);
        if (!row) return;

        row.innerHTML = "";

        const out = Array.isArray(chips) ? chips.slice(0) : [];
        const hasFilters = dashAnyFiltersActive(tileRoot);

        // Add a baseline reset when any cross-filters are active
        if (hasFilters) {
        out.unshift({ reset: true });
        }

        if (!out.length) {
        row.classList.add("d-none");
        return;
        }
        row.classList.remove("d-none");

        for (const ch of out) {
        const b = document.createElement("button");
        b.type = "button";

        if (ch.reset) {
        b.className = "insight-chip";
        b.innerHTML = `<span class="ic"><i class="fa-solid fa-rotate-left"></i></span><span>Reset</span>`;
        b.addEventListener("click", () => dashResetDataset(tileRoot));
        row.appendChild(b);
        continue;
        }

        b.className = `insight-chip ${ch.cls || ""}`.trim();
        b.innerHTML = `<span class="ic"><i class="fa-solid fa-wand-magic-sparkles"></i></span><span>${esc(ch.text)}</span>`;
        b.addEventListener("click", () => {
        if (ch.filterField != null && ch.filterValue != null) {
        dashBroadcastFilter(tileRoot, ch.filterField, ch.filterValue, "set");
        } else if (ch.focusName != null) {
        dashFocusName(tileRoot, ch.focusName);
        }
        });
        row.appendChild(b);
        }
        }

        // ── 3) Cross-filtering (safe mode: only when exactly 1 dimension drives the visual) ──
        function dashBroadcastFilter(sourceTileRoot, field, value, mode /* 'set' | 'toggle' | 'clear' */) {
        const src = sourceTileRoot?._state;
        if (!src?.dataset?.schema || !src?.dataset?.obj) return;

        const schema = src.dataset.schema;
        const obj = src.dataset.obj;

        const tiles = Array.from(document.querySelectorAll(".tile"))
        .filter(t => t?._state?.dataset?.schema === schema && t?._state?.dataset?.obj === obj);

        for (const t of tiles) {
        const st = t._state;
        const meta = st?.byName?.[field];
        if (!meta) continue;
        if (meta.category === "measure") continue; // never filter measures

        if (!st.pivot.filters) st.pivot.filters = {};

        if (mode === "clear") {
        delete st.pivot.filters[field];
        } else {
        const sval = (value == null) ? null : String(value);
        const spec = st.pivot.filters[field] || { mode: "in", values: [], fromUtc: null, toUtc: null };
        spec.mode = "in";
        spec.values = Array.isArray(spec.values) ? spec.values : [];

        if (mode === "toggle") {
        const ix = spec.values.findIndex(x => String(x) === String(sval));
        if (ix >= 0) spec.values.splice(ix, 1);
        else spec.values.push(sval);
        if (!spec.values.length) { delete st.pivot.filters[field]; }
        else st.pivot.filters[field] = spec;
        } else {
        spec.values = [sval];
        st.pivot.filters[field] = spec;
        }
        }

        try { renderWells(t); } catch { }
        try { updateFiltersUi(t); } catch { }

        // always re-run (cross-filter should visibly update)
        setTimeout(() => { try { runAggregate(t); } catch { } }, 0);
        }
        }

        function dashHandleChartClick(ctx, params) {
        const field = ctx?.primaryDim;
        if (!field) return;

        const meta = ctx.tileRoot?._state?.byName?.[field];
        if (!meta || meta.category === "measure") return;

        const name = params?.name;
        if (name == null || name === "") return;

        const ev = params?.event?.event;
        const mode =
        ev?.altKey ? "clear" :
        (ev?.ctrlKey || ev?.metaKey) ? "toggle" :
        "set";

        dashBroadcastFilter(ctx.tileRoot, field, name, mode);
        }

        function dashAnyFiltersActive(tileRoot) {
        const f = tileRoot?._state?.pivot?.filters;
        if (!f) return false;
        return Object.keys(f).some(k => {
        const spec = f[k];
        if (!spec) return false;
        if (Array.isArray(spec.values) && spec.values.length) return true;
        if (spec.fromUtc || spec.toUtc) return true;
        return false;
        });
        }

        function dashResetDataset(tileRoot) {
        const s = tileRoot?._state;
        if (!s?.dataset?.schema || !s?.dataset?.obj) return;

        const schema = s.dataset.schema;
        const obj = s.dataset.obj;

        const tiles = Array.from(document.querySelectorAll(".tile"))
        .filter(t => t?._state?.dataset?.schema === schema && t?._state?.dataset?.obj === obj);

        for (const t of tiles) {
        try { t._chart?.dispatchAction({ type: "downplay" }); } catch { }
        try { t._chart?.dispatchAction({ type: "hideTip" }); } catch { }

        if (t._state?.pivot) t._state.pivot.filters = {};

        try { renderWells(t); } catch { }
        try { updateFiltersUi(t); } catch { }

        setTimeout(() => { try { runAggregate(t); } catch { } }, 0);
        }
        }

        function buildChartContext(tileRoot, res) {
        const chartType = getEl(tileRoot, "chartType").value;
        const chartWrap = getEl(tileRoot, "chart");
        const data = res?.data || [];
        const rowFields = res?.rowFields || [];
        const colFields = res?.colFields || [];
        const valueFields = (res?.valueFields && res.valueFields.length) ? res.valueFields : ["Value"];

        // CSS-scale for tight tiles: keep entire visual visible and shrink fonts
        const wPx = chartWrap.clientWidth || 1;
        const hPx = chartWrap.clientHeight || 1;
        const scale = Math.max(0.60, Math.min(1, Math.min(wPx / 520, hPx / 360)));
        tileRoot.style.setProperty("--viz-scale", String(scale));

        const dimFields = [...rowFields, ...colFields];
        const primaryDim = (dimFields.length === 1) ? dimFields[0] : null; // SAFE cross-filter mode

        return {
        tileRoot,
        chartWrap,
        chartType,
        res,
        data,
        rowFields,
        colFields,
        valueFields,
        agg: res?.agg,
        scale,
        wPx,
        hPx,
        dimFields,
        primaryDim
        };
        }

        function validateVisual(ctx) {
        const { chartType, rowFields, colFields, valueFields } = ctx;

        if (chartType === "slicer") {
        if (rowFields.length !== 1)
        return "Slicer / Dropdown requires exactly 1 row dimension.";
        return null;
        }

        if (chartType === "waterfall") {
        if (valueFields.length !== 1)
        return "Waterfall requires exactly 1 measure.";
        if (rowFields.length === 0)
        return "Waterfall requires a row dimension.";
        }

        if (chartType === "sankey") {
        if (rowFields.length !== 1 || colFields.length !== 1)
        return "Sankey requires 1 row and 1 column field.";
        if (valueFields.length !== 1)
        return "Sankey requires exactly 1 measure.";
        }

        if (chartType === "treemap" || chartType === "sunburst" || chartType === "funnel") {
        if (valueFields.length !== 1)
        return "This visual requires exactly 1 measure.";
        if (rowFields.length + colFields.length === 0)
        return "This visual requires at least 1 dimension.";
        }

        if (chartType === "radar") {
        if (rowFields.length === 0)
        return "Radar requires a row dimension.";
        if (valueFields.length !== 1)
        return "Radar requires exactly 1 measure.";
        }

        if (chartType === "gaugeRing" && valueFields.length < 1) return "Ring Gauges requires at least 1 measure.";
        if (chartType === "bump") {
        if (!rowFields.length) return "Bump Chart requires a row dimension (entities).";
        if (!colFields.length) return "Bump Chart requires a column dimension (time/category).";
        if (valueFields.length !== 1) return "Bump Chart requires exactly 1 measure.";
        }
        if (chartType === "marimekko") {
        if (!rowFields.length) return "Marimekko requires a row dimension (columns).";
        if (!colFields.length) return "Marimekko requires a column dimension (segments).";
        if (valueFields.length !== 1) return "Marimekko requires exactly 1 measure.";
        }
        if (chartType === "multiples") {
        if (rowFields.length === 0 || colFields.length === 0)
        return "Small multiples requires 1 row and 1 column dimension.";
        if (valueFields.length !== 1)
        return "Small multiples requires exactly 1 measure.";
        }

        if (chartType === "heat") {
        if (valueFields.length !== 1)
        return "Heatmap requires exactly 1 measure.";
        if (rowFields.length + colFields.length === 0)
        return "Heatmap needs at least 1 dimension.";
        }

        if (chartType === "stacked100") {
        if (valueFields.length < 1)
        return "100% stacked needs at least 1 measure.";
        }

        return null;
        }

        function keyOf(fields, row) {
        if (!fields?.length) return "(all)";
        return fields.map(f => {
        const v = row?.[f];
        return (v == null || v === "") ? "(null)" : String(v);
        }).join(" • ");
        }

        function sortKeysForField(keys, fields, byName) {
        if (!fields || fields.length !== 1) return keys;

        const meta = byName?.[fields[0]];
        if (!meta) return keys;

        const shouldNumericSort = isIntLikeField(meta) || meta.canGroup === true;
        if (!shouldNumericSort) return keys;

        return keys.slice().sort((a, b) => {
        const na = Number(a), nb = Number(b);
        const fa = Number.isFinite(na), fb = Number.isFinite(nb);

        if (fa && fb) return na - nb;
        if (fa) return -1;
        if (fb) return 1;
        return String(a).localeCompare(String(b));
        });
        }

        function buildPivotMap(ctx) {
        const { data, rowFields, colFields, valueFields } = ctx;
        const rowOrder = [], colOrder = [];
        const seenR = new Set(), seenC = new Set();
        const cell = new Map();

        for (const r of data) {
        const rk = keyOf(rowFields, r);
        const ck = keyOf(colFields, r);
        if (!seenR.has(rk)) { seenR.add(rk); rowOrder.push(rk); }
        if (!seenC.has(ck)) { seenC.add(ck); colOrder.push(ck); }

        const k = rk + "||" + ck;
        const obj = cell.get(k) || {};
        for (const vf of valueFields) {
        const v = Number(r?.[vf]);
        obj[vf] = (obj[vf] || 0) + (Number.isFinite(v) ? v : 0);
        }
        cell.set(k, obj);
        }

        const getCellVal = (rk, ck, vf) => (cell.get(rk + "||" + ck)?.[vf]) ?? 0;

        const byName = ctx.tileRoot?._state?.byName || {};

        return {
        rowOrder: sortKeysForField(rowOrder, rowFields, byName),
        colOrder: sortKeysForField(colOrder, colFields, byName),
        hasRows: rowFields.length > 0,
        hasCols: colFields.length > 0,
        getCellVal
        };
        }

        function createChartHost(ctx, extraClass = "") {
        const host = document.createElement("div");
        host.className = extraClass;
        host.style.width = "100%";
        host.style.height = "100%";
        ctx.chartWrap.appendChild(host);

        // scale down (CSS) so small tiles keep the entire visual visible
        const s = ctx.scale ?? 1;
        if (s < 0.999) {
        host.style.transform = `scale(${s})`;
        host.style.transformOrigin = "top left";
        host.style.width = (100 / s) + "%";
        host.style.height = (100 / s) + "%";
        }

        const chart = dashWrapChart(echarts.init(host, 'vivid'));

        // Double-click anywhere on the chart to return to baseline (clears cross-filters)
        try {
        const zr = chart.getZr();
        if (zr) {
        zr.off("dblclick");
        zr.on("dblclick", () => dashResetDataset(ctx.tileRoot));
        }
        } catch { }

        // cross-filter (SAFE: only when exactly one dimension drives the visual)
        try {
        chart.off("click");
        chart.on("click", p => dashHandleChartClick(ctx, p));
        } catch { }

        return chart;
        }

        function renderTable(ctx) {
        renderRawTable(ctx.chartWrap, ctx.data);
        }

        function renderPivot(ctx) {
        const pm = buildPivotMap(ctx);
        const rL = pm.rowOrder.length ? pm.rowOrder : ["(all)"];
        const cL = pm.colOrder.length ? pm.colOrder : ["(all)"];
        const vf = ctx.valueFields[0] || "Value";
        renderPivotTable(ctx.chartWrap, rL, cL, (rLab, cLab) => pm.getCellVal(pm.hasRows ? rLab : "(all)", pm.hasCols ? cLab : "(all)", vf));
        }

        function renderKpi(ctx) {
        const { tileRoot, data, valueFields, rowFields, colFields, res } = ctx;
        const vf0 = valueFields[0] || "Value";
        const vf1 = valueFields[1] || null;

        let sum0 = 0, sum1 = 0;
        for (const r of data) {
        const a = Number(r?.[vf0]);
        if (Number.isFinite(a)) sum0 += a;
        if (vf1) {
        const b = Number(r?.[vf1]);
        if (Number.isFinite(b)) sum1 += b;
        }
        }

        if (!vf1) {
        renderKpiCard(ctx.chartWrap,
        `${res?.agg === "Count" ? "Count" : `${res?.agg}(${vf0})`}`,
        fmtAbbrev(sum0),
        (rowFields.length || colFields.length) ? "Summed across current result set" : "");
        setTimeout(() => fitKpiVisual(tileRoot), 0);
        } else {
        renderKpiGauge(tileRoot,
        `${res?.agg === "Count" ? "Count" : `${res?.agg}(${vf0})`} vs ${vf1}`,
        sum0, sum1);
        setTimeout(() => fitKpiVisual(tileRoot), 0);
        }
        }

        function renderHeatmap(ctx) {
        const pm = buildPivotMap(ctx);
        const vf = ctx.valueFields[0] || "Value";
        const rr = pm.hasRows ? (pm.rowOrder.length ? pm.rowOrder : ["(all)"]) : ["(all)"];
        const cc = pm.hasCols ? (pm.colOrder.length ? pm.colOrder : ["(all)"]) : ["(all)"];

        const chart = createChartHost(ctx);
        ctx.tileRoot._chart = chart;

        const heat = [];
        for (let i = 0; i < rr.length; i++)
        for (let j = 0; j < cc.length; j++)
        heat.push([j, i, pm.getCellVal(rr[i], cc[j], vf)]);

        const maxV = Math.max(...heat.map(x => x[2] || 0), 1);

        const _af = AXIS_FONT;
        chart.setOption({
        title: { text: `${(ctx.res?.agg === 'Count') ? 'Count' : `${ctx.res?.agg}(${vf})`} • Heatmap`, left: 10, top: 6, textStyle: { fontSize: 11, fontWeight: 600 } },
        tooltip: { formatter: p => `${esc(rr[p.value[1]])} · ${esc(cc[p.value[0]])}<br/><b>${esc(fmt2(p.value[2]))}</b>` },
        toolbox: { right: 10, top: 6, itemSize: 14, feature: { restore: {}, saveAsImage: {} } },
        grid: { left: 70, right: 90, top: 44, bottom: 50, containLabel: true },
        xAxis: { type: 'category', data: cc, axisLabel: { rotate: cc.length > 3 ? 90 : 0, fontSize: _af, margin: 10 } },
        yAxis: { type: 'category', data: rr, axisLabel: { fontSize: _af } },
        visualMap: {
        min: 0, max: maxV, calculable: true, right: 10, top: 52,
        inRange: { color: CORP_PAL },
        textStyle: { color: CORP_PAL[8], fontSize: 10 }
        },
        series: [{
        type: 'heatmap', data: heat,
        label: { show: heat.length <= 300, fontSize: 9, formatter: p => fmtAbbrev(p.value[2]) },
        emphasis: { itemStyle: { shadowBlur: 14, shadowColor: 'rgba(8,8,238,0.5)' } }
        }]
        }, { notMerge: true });

        setTimeout(() => { try { chart.resize(); chart.dispatchAction({ type: 'restore' }); } catch (e) { } }, 0);
        }

        function renderPie(ctx, isDonut) {
        const { data, rowFields, colFields, valueFields, res } = ctx;
        const vf = (valueFields && valueFields.length) ? valueFields[0] : "Value";
        const labelFields = [...rowFields, ...colFields];
        const byLabel = new Map();

        for (const r of data) {
        const label = labelFields.length ? keyOf(labelFields, r) : "(all)";
        const v = Number(r?.[vf]);
        byLabel.set(label, (byLabel.get(label) || 0) + (Number.isFinite(v) ? v : 0));
        }

        let items = Array.from(byLabel.entries()).map(([name, value]) => ({ name, value }))
        .sort((a, b) => (b.value || 0) - (a.value || 0));

        const TOP_N = 24;
        if (items.length > TOP_N) {
        const head = items.slice(0, TOP_N);
        const other = items.slice(TOP_N).reduce((s, x) => s + (Number(x.value) || 0), 0);
        items = other !== 0 ? [...head, { name: "Other", value: other }] : head;
        }

        const total = items.reduce((s, x) => s + (Number(x.value) || 0), 0);
        if (!Number.isFinite(total) || total === 0) {
        ctx.chartWrap.innerHTML = `<div class="empty">Pie needs non-zero numeric values (first measure: <b>${esc(vf)}</b>).</div>`;
        return;
        }

        const chart = createChartHost(ctx);
        ctx.tileRoot._chart = chart;

        const PAL_PIE = CORP_PAL;
        const itemsColored = items.map((d, i) => ({
        ...d, itemStyle: {
        color: PAL_PIE[i % PAL_PIE.length],
        shadowBlur: 0, borderRadius: 8, borderColor: '#fff', borderWidth: 2
        }
        }));
        chart.setOption({
        title: { text: (res?.agg === 'Count') ? `Count • ${isDonut ? 'Donut' : 'Pie'}` : `${res?.agg}(${vf}) • ${isDonut ? 'Donut' : 'Pie'}`, left: 10, top: 6, textStyle: { fontSize: 11, fontWeight: 600 } },
        tooltip: {
        trigger: 'item',
        formatter: p => `<b>${esc(p.name)}</b><br/>${fmtAbbrev(p?.value ?? 0)}<br/><span style='color:${CORP_PAL[1]};font-weight:700'>${p?.percent ?? 0}%</span>`
        },
        legend: { type: 'scroll', top: 28, left: 10, right: 10, textStyle: { fontSize: 10 } },
        series: [{
        name: vf, type: 'pie',
        radius: isDonut ? ['42%', '70%'] : '70%',
        center: ['50%', '58%'],
        avoidLabelOverlap: true, minAngle: 3,
        label: {
        fontSize: 11,
        formatter: p => `{name|${p.name}}\n{v|${fmtAbbrev(p.value)}} {pct|${p.percent}%}`,
        rich: { name: { fontSize: 10, color: '#212121' }, v: { fontSize: 12, fontWeight: 700, color: CORP_PAL[0] }, pct: { fontSize: 10, color: CORP_PAL[8] } }
        },
        labelLine: { length: 12, length2: 10, smooth: true },
        emphasis: {
        scale: true, scaleSize: 8,
        itemStyle: { shadowBlur: 24, shadowColor: 'rgba(8,8,238,0.35)' },
        label: { fontSize: 13, fontWeight: 700 }
        },
        selectedMode: 'single',
        select: { itemStyle: { shadowBlur: 30, shadowColor: 'rgba(8,8,238,0.5)' } },
        data: itemsColored
        }]
        }, { notMerge: true });

        setTimeout(() => { try { chart.resize(); } catch (e) { } }, 0);
        }

        function renderXY(ctx, mode) {
        const { tileRoot, res, valueFields, wPx } = ctx;
        const pm = buildPivotMap(ctx);
        const af = Math.max(11, Math.min(15, Math.round((wPx || 600) / 48)));
        const PAL_XY = CORP_PAL;

        const multiAxis = valueFields.length > 1;
        const yAxis = multiAxis
        ? [{ type: 'value', axisLabel: { fontSize: af, formatter: v => fmtAbbrev(v) }, scale: true, name: valueFields[0] },
        { type: 'value', axisLabel: { fontSize: af, formatter: v => fmtAbbrev(v) }, scale: true, name: valueFields.slice(1).join(', ') }]
        : { type: 'value', axisLabel: { fontSize: af, formatter: v => fmtAbbrev(v) }, scale: true };

        const isScatter = (mode === 'scatter'), isLine = (mode === 'line'), isArea = (mode === 'area'),
        isStackedBar = (mode === 'stackedBar'), isStackedArea = (mode === 'stackedArea'),
        isCombo = (mode === 'combo'), isHBar = (mode === 'hbar');

        const seriesType = () => isScatter ? 'scatter' : (isLine || isArea || isStackedArea) ? 'line' : 'bar';

        // Rich per-series styling
        const mkS = (name, type, data, idx, extra2 = {}) => {
        const c = PAL_XY[idx % PAL_XY.length];
        const isL = type === 'line', isB = type === 'bar';
        return {
        name, type, data,
        ...(extra2.stack ? { stack: extra2.stack } : {}),
        ...(extra2.yi != null ? { yAxisIndex: extra2.yi } : {}),
        smooth: isL ? 0.35 : undefined,
        symbolSize: isL ? 7 : undefined,
        itemStyle: { color: c, ...(isB ? { borderRadius: [4, 4, 0, 0] } : {}) },
        lineStyle: isL ? { width: 2.5, color: c, shadowBlur: 8, shadowColor: c + '55' } : undefined,
        areaStyle: (isArea || isStackedArea) ? {
        color: {
        type: 'linear', x: 0, y: 0, x2: 0, y2: 1,
        colorStops: [{ offset: 0, color: c + 'CC' }, { offset: 1, color: c + '0A' }]
        }
        } : undefined,
        emphasis: isB
        ? { itemStyle: { shadowBlur: 20, shadowColor: c + '99', shadowOffsetY: -3 } }
        : { scale: true, scaleSize: 5, lineStyle: { width: 4 } },
        markLine: (isL || isB) && !extra2.stack && data.some(v => v != null) ? {
        silent: true, symbol: 'none',
        lineStyle: { type: 'dashed', color: c + '66', width: 1.5 },
        label: {
        show: true, position: 'insideEndTop', fontSize: 10,
        color: c, formatter: p => 'avg ' + fmtAbbrev(p.value)
        },
        data: [{ type: 'average' }]
        } : undefined
        };
        };

        let xCats = [], series = [];
        if (pm.hasRows && !pm.hasCols) {
        xCats = pm.rowOrder.length ? pm.rowOrder : ['(all)'];
        if (isCombo) valueFields.forEach((vf, i) => series.push(mkS(vf, i === 0 ? 'line' : 'bar', xCats.map(rk => pm.getCellVal(rk, '(all)', vf)), i, { yi: (multiAxis && i > 0) ? 1 : 0 })));
        else if (isStackedBar || isStackedArea) valueFields.forEach((vf, i) => series.push(mkS(vf, seriesType(), xCats.map(rk => pm.getCellVal(rk, '(all)', vf)), i, { stack: 'total', yi: (multiAxis && i > 0) ? 1 : 0 })));
        else valueFields.forEach((vf, i) => series.push(mkS(vf, seriesType(), xCats.map(rk => pm.getCellVal(rk, '(all)', vf)), i, { yi: (multiAxis && i > 0) ? 1 : 0 })));
