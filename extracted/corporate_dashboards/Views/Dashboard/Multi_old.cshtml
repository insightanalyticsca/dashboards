@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard Constructor";
    var defaultSchema = ((string)(ViewBag.DefaultSchema ?? "")).Trim();

    var suiteNavQuery = (Context.Request.Query["suiteNav"].ToString() ?? "").Trim();
    var layoutTitleQuery = (Context.Request.Query["layoutTitle"].ToString() ?? "").Trim();

    /*
        Hardcoded suite/external mode for:
        /analytics_build_app/Dashboard/Multi?layoutTitle=AR Dashboard&suiteNav=aging_desk_app

        Keep controls in DOM because JS binds to btnAdd, btnReset, btnVerPrev, etc.
        Hide them with CSS instead of removing them with @if.
    */
    var suiteHostMode =
        string.Equals(suiteNavQuery, "aging_desk_app", StringComparison.OrdinalIgnoreCase)
        || string.Equals(layoutTitleQuery, "AR Dashboard", StringComparison.OrdinalIgnoreCase);
}

@Html.AntiForgeryToken()

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/gridstack@11.3.0/dist/gridstack.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">



<div id="dashboardConstructorRoot"
     class="container-fluid py-2 @(suiteHostMode ? "constructor-suite-mode" : "")"
     data-suite-host="@(suiteHostMode ? "1" : "0")">
    <div class="constructor-local-chrome d-flex align-items-center justify-content-between mb-2">
        <div class="min-w-0">
            <h6 class="mb-0">Dashboard Constructor</h6>
            <div class="text-muted" style="font-size:12px;">Metadata-first • Server aggregation • Lazy filter values</div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- Version KPI — click to open browse modal -->
            <div class="ver-kpi" id="verKpi" title="Browse versions" style="cursor:pointer;">
                <div class="mini-gauge" id="verGauge" style="--p:0"></div>
                <div class="mini-kpi-text">
                    <div class="kpi-title">Version</div>
                    <div class="kpi-value" id="verLabel">v0/0</div>
                </div>
            </div>

            <div class="d-flex gap-1" aria-label="Version navigation">
                <button id="btnVerPrev" class="icon-btn icon-btn-tiny" title="Previous version" aria-label="Previous version">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button id="btnVerNext" class="icon-btn icon-btn-tiny" title="Next version" aria-label="Next version">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
                <button id="btnVerSave" class="icon-btn icon-btn-tiny" title="Save new version" aria-label="Save new version">
                    <i class="fa-solid fa-bookmark"></i>
                </button>
                <button id="btnTidy" class="icon-btn icon-btn-tiny" title="Tidy layout" aria-label="Tidy layout">
                    <i class="fa-solid fa-table-cells-large"></i>
                </button>
            </div>

            <!-- NO ver-picker dropdown -->

            <div class="d-flex gap-2">
                <button id="btnAdd" class="icon-btn icon-btn-primary" title="Add canvas" aria-label="Add canvas">
                    <i class="fa-solid fa-plus"></i>
                </button>
                <button id="btnReset" class="icon-btn" title="Reset canvases" aria-label="Reset canvases">
                    <i class="fa-solid fa-rotate-left"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- ── Save version modal ── -->
    <div class="modal-backdrop d-none" id="saveVerModal">
        <div class="modal-card" style="max-width:420px;">
            <div class="modal-head">
                <div class="fw-semibold" style="font-size:13px;">Save Version</div>
                <button type="button" class="icon-btn icon-btn-danger" id="saveVerClose">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">
                <label style="font-size:11px;color:rgba(0,0,0,.55)">Version name</label>
                <input id="saveVerName" class="form-control form-control-sm" placeholder="Enter version name" />
                <div class="mt-3">
                    <label style="font-size:11px; display:flex; align-items:center; gap:6px; cursor:pointer;">
                        <input type="checkbox" id="saveVerFav" />
                        <i class="fa-solid fa-star" style="color:#f59f00;font-size:11px;"></i>
                        Mark as favorite
                    </label>
                </div>
            </div>
            <div class="modal-foot">
                <div></div>
                <button type="button" class="icon-btn icon-btn-dark" id="saveVerConfirm" title="Save">
                    <i class="fa-solid fa-check"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- ── Browse versions modal (open via verKpi OR < >) ── -->
    <div class="modal-backdrop d-none" id="browseVerModal">
        <div class="modal-card" style="max-width:500px;">
            <div class="modal-head">
                <div class="fw-semibold" style="font-size:13px;">
                    <i class="fa-solid fa-clock-rotate-left" style="font-size:11px;margin-right:4px;"></i>
                    Versions
                </div>
                <button type="button" class="icon-btn icon-btn-danger" id="browseVerClose">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body" style="padding:8px;">
                <div id="browseVerList" style="display:flex;flex-direction:column;gap:6px;"></div>
            </div>
        </div>
    </div>

    <div class="grid-stack" id="grid"></div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
    <script src="~/js/corporate-dashboard-visuals.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gridstack@11.3.0/dist/gridstack-all.js"></script>

    <script>
        (function () {
        const root = document.getElementById("dashboardConstructorRoot");
        const suiteMode = root && root.getAttribute("data-suite-host") === "1";

        if (!suiteMode) return;

        document.documentElement.classList.add("dash-suite-mode");

        if (document.body) {
        document.body.classList.add("dash-suite-mode");
        }

        if (root) {
        root.classList.add("constructor-suite-mode");
        }
        })();
    </script>

    <script>
        /* DASH PATCH: queued tile renders + queued custom HTML data fetches */

        // -----------------------------
        // Config
        // -----------------------------
        const endpoints = {
        connections: '@Url.Action("GetConnections", "Dashboard")',
        schemas: '@Url.Action("GetSchemas", "Dashboard")',
        objects: '@Url.Action("GetObjects", "Dashboard")',
        columns: '@Url.Action("GetColumns", "Dashboard")',
        distinct: '@Url.Action("GetDistinctValues", "Dashboard")',
        aggregate: '@Url.Action("Aggregate", "Dashboard")',
        narrate: '@Url.Action("Narrate", "Dashboard")',
        customHtmlConfig: '@Url.Action("GetCustomHtmlConfig", "Dashboard")',
        customHtmlTemplates: '@Url.Action("GetCustomHtmlTemplates", "Dashboard")',
        customHtmlLive: '@Url.Action("GetCustomHtmlLiveData", "Dashboard")',
        layoutHistory: '@Url.Action("GetLayoutHistory", "Dashboard")',
        layoutGet: '@Url.Action("GetLayoutVersion", "Dashboard")',
        layoutSave: '@Url.Action("SaveLayoutVersion", "Dashboard")',
        layoutDelete: '@Url.Action("DeleteLayoutVersion", "Dashboard")',
        layoutGetCurrent: '@Url.Action("GetCurrentLayout", "Dashboard")',
        layoutSetCurrent: '@Url.Action("SetCurrentLayout", "Dashboard")',
        layoutSetFav: '@Url.Action("SetLayoutFavorite", "Dashboard")'
        };

        const APP_BASE_PATH = (() => {
        const raw = '@Url.Content("~/")';
        return String(raw || '').replace(/\/+$/, '');
        })();

        function appUrl(path) {
        const raw = String(path || '').trim();
        if (!raw) return raw;
        if (/^(?:[a-z][a-z0-9+.-]*:)?\/\//i.test(raw) || raw.startsWith('data:') || raw.startsWith('blob:')) return raw;

        let normalized = raw;
        if (normalized.startsWith('~/')) {
        normalized = '/' + normalized.slice(2);
        } else if (!normalized.startsWith('/')) {
        normalized = '/' + normalized;
        }

        if (APP_BASE_PATH && (normalized === APP_BASE_PATH || normalized.startsWith(APP_BASE_PATH + '/'))) {
        return normalized;
        }

        return `${APP_BASE_PATH}${normalized}` || normalized;
        }

        const DEFAULT_SCHEMA = @Html.Raw(JsonSerializer.Serialize(defaultSchema));


        const sharedSlicerStore = new Map();

        const dashboardUrlParams = new URLSearchParams(window.location.search);
        const dashboardLayoutTitle = dashboardUrlParams.get('layoutTitle') || '';

        const dashboardLayoutVersionIdRaw =
        dashboardUrlParams.get('layoutVersionId') ||
        dashboardUrlParams.get('layoutversionid') ||
        dashboardUrlParams.get('versionId') ||
        dashboardUrlParams.get('versionid') ||
        '';

        const dashboardLayoutVersionId = Number.parseInt(dashboardLayoutVersionIdRaw, 10);

        function appendDashboardLayoutTitle(url, currentLayoutInfo) {
        const title =
        dashboardLayoutTitle ||
        (currentLayoutInfo && currentLayoutInfo.titleOverride ? currentLayoutInfo.title : '');

        if (!title) return url;

        return url +
        (url.includes('?') ? '&' : '?') +
        'layoutTitle=' + encodeURIComponent(title);
        }

        (function () {
        const params = new URLSearchParams(window.location.search);
        const layoutTitle = params.get('layoutTitle');

        if (!layoutTitle) return;

        function patchDashboardUrl(url) {
        if (!url) return url;

        const raw = String(url);

        const isLayoutCall =
        raw.includes('/Dashboard/GetCurrentLayout') ||
        raw.includes('/Dashboard/GetLayoutVersion') ||
        raw.includes('Dashboard/GetCurrentLayout') ||
        raw.includes('Dashboard/GetLayoutVersion');

        if (!isLayoutCall) return url;

        if (raw.includes('layoutTitle=')) return url;

        return raw + (raw.includes('?') ? '&' : '?') +
        'layoutTitle=' + encodeURIComponent(layoutTitle);
        }

        // Patch fetch(...)
        if (window.fetch) {
        const originalFetch = window.fetch;

        window.fetch = function (input, init) {
        if (typeof input === 'string') {
        input = patchDashboardUrl(input);
        } else if (input && input.url) {
        const patchedUrl = patchDashboardUrl(input.url);
        if (patchedUrl !== input.url) {
        input = new Request(patchedUrl, input);
        }
        }

        return originalFetch.call(this, input, init);
        };
        }

        // Patch XMLHttpRequest, which covers jQuery $.ajax / $.getJSON
        const originalOpen = XMLHttpRequest.prototype.open;

        XMLHttpRequest.prototype.open = function (method, url) {
        arguments[1] = patchDashboardUrl(url);
        return originalOpen.apply(this, arguments);
        };

        console.log('Dashboard layoutTitle override active:', layoutTitle);
        })();

        function datasetKey(schema, obj) {
        return `${String(schema || "").trim().toLowerCase()}|${String(obj || "").trim().toLowerCase()}`;
        }

        function getTileId(tileRoot) {
        return String(tileRoot?.dataset?.tileId || "");
        }

        function getSlicerField(tileRoot) {
        const state = tileRoot?._state;
        const rows = Array.isArray(state?.pivot?.rows) ? state.pivot.rows.filter(Boolean) : [];
        return rows[0] || "";
        }

        function getSharedFilters(tileRoot, options = {}) {
        const excludeTileId = options.excludeTileId || "";
        const excludeField = options.excludeField || "";
        const state = tileRoot?._state;
        const key = datasetKey(state?.dataset?.schema, state?.dataset?.obj);
        const merged = {};

        for (const entry of sharedSlicerStore.values()) {
        if (!entry || entry.datasetKey !== key) continue;
        if (excludeTileId && entry.tileId === excludeTileId) continue;
        if (excludeField && String(entry.field || "").toLowerCase() === String(excludeField).toLowerCase()) continue;
        if (!entry.value) continue;

        const field = entry.field;
        if (!field || merged[field]) continue;

        merged[field] = {
        mode: "in",
        values: [String(entry.value)],
        fromUtc: null,
        toUtc: null
        };
        }

        return merged;
        }

        function rerenderTilesForDataset(schema, obj, sourceTileId = "") {
        const key = datasetKey(schema, obj);
        document.querySelectorAll(".tile").forEach(tile => {
        if (!tile || getTileId(tile) === sourceTileId) return;
        const state = tile._state;
        if (!state) return;
        if (datasetKey(state.dataset?.schema, state.dataset?.obj) !== key) return;

        const chartType = getEl(tile, "chartType")?.value || "";
        const req = buildAggRequest(tile);
        const canRender =
        !!req.schema &&
        !!req.obj &&
        (
        chartType === "customHtml" ||
        chartType === "slicer" ||
        req.agg === "Count" ||
        (req.values && req.values.length)
        );

        if (canRender) {
        runAggregate(tile);
        }
        });
        }

        function clearSharedSlicer(tileRoot, shouldBroadcast = true) {
        const tileId = getTileId(tileRoot);
        const existing = sharedSlicerStore.get(tileId);
        sharedSlicerStore.delete(tileId);

        if (existing && shouldBroadcast) {
        rerenderTilesForDataset(existing.schema, existing.obj, tileId);
        }
        }

        function publishSharedSlicer(tileRoot, fieldName, selectedValue) {
        const state = tileRoot?._state;
        const tileId = getTileId(tileRoot);
        if (!state || !tileId || !fieldName) return;

        const schema = String(state.dataset?.schema || "").trim();
        const obj = String(state.dataset?.obj || "").trim();
        clearSharedSlicer(tileRoot, false);

        if (!selectedValue) {
        rerenderTilesForDataset(schema, obj, tileId);
        return;
        }

        sharedSlicerStore.set(tileId, {
        tileId,
        schema,
        obj,
        datasetKey: datasetKey(schema, obj),
        field: fieldName,
        value: selectedValue
        });

        rerenderTilesForDataset(schema, obj, tileId);
        }


        let CUSTOM_HTML_TEMPLATES = [{ id: "", key: "", label: "Auto / appsettings rule", htmlUrl: "", schema: "*", object: "*", payloadMode: "", rowFields: [], colFields: [], valueFields: [], filters: {}, dateGroups: {} }];
        let CUSTOM_HTML_TEMPLATES_LOADED = false;

        async function loadCustomHtmlTemplates() {
        const out = await apiGet(endpoints.customHtmlTemplates);
        const list = Array.isArray(out?.templates) ? out.templates : [];
        CUSTOM_HTML_TEMPLATES = [{ id: "", key: "", label: "Auto / appsettings rule", htmlUrl: "", schema: "*", object: "*", payloadMode: "", rowFields: [], colFields: [], valueFields: [], filters: {}, dateGroups: {} }]
        .concat(list.map(t => ({
        ...t,
        id: String(t.id || t.key || "").trim(),
        key: String(t.key || t.id || "").trim(),
        object: String(t.object || t.obj || "").trim(),
        schema: String(t.schema || "*").trim() || "*",
        rowFields: Array.isArray(t.rowFields) ? t.rowFields.filter(Boolean) : [],
        colFields: Array.isArray(t.colFields) ? t.colFields.filter(Boolean) : [],
        valueFields: Array.isArray(t.valueFields) ? t.valueFields.filter(Boolean) : [],
        filters: t.filters && typeof t.filters === "object" ? t.filters : {},
        dateGroups: t.dateGroups && typeof t.dateGroups === "object" ? t.dateGroups : {}
        })))
        .filter(t => t && typeof t === "object" && String(t.id || "").length >= 0);
        CUSTOM_HTML_TEMPLATES_LOADED = true;
        return CUSTOM_HTML_TEMPLATES;
        }

        async function ensureCustomHtmlTemplatesLoaded() {
        if (CUSTOM_HTML_TEMPLATES_LOADED) return CUSTOM_HTML_TEMPLATES;
        return await loadCustomHtmlTemplates();
        }

        function getAllCustomHtmlTemplates() {
        return CUSTOM_HTML_TEMPLATES;
        }

        function getCustomHtmlTemplateById(id) {
        const key = String(id || "").trim();
        return getAllCustomHtmlTemplates().find(t => String(t.id || t.key || "") === key) || getAllCustomHtmlTemplates()[0] || null;
        }

        function normalizeSqlObjectName(value) {
        return String(value || "")
        .trim()
        .replace(/\s*\((view|table|procedure|proc|function)\)\s*$/i, "")
        .replace(/^\[?dbo\]?\./i, "")
        .replace(/[\[\]]/g, "")
        .toLowerCase();
        }

        function normalizeSqlSchemaName(value) {
        return String(value || "dbo")
        .trim()
        .replace(/[\[\]]/g, "")
        .toLowerCase();
        }

        function objectMatchesTemplate(template, obj) {
        if (!template?.object || template.object === "*") return true;
        return normalizeSqlObjectName(template.object) === normalizeSqlObjectName(obj);
        }

        function schemaMatchesTemplate(template, schema) {
        if (!template?.schema || template.schema === "*") return true;
        return normalizeSqlSchemaName(template.schema) === normalizeSqlSchemaName(schema);
        }

        function selectRecommendedHtmlTemplateForObject(tileRoot) {
        const state = tileRoot?._state || {};
        const currentId = String(state.customHtmlTemplate || getEl(tileRoot, "htmlTemplate")?.value || "").trim();
        if (currentId) return getCustomHtmlTemplateById(currentId);
        const schema = state.dataset?.schema || "";
        const obj = state.dataset?.obj || "";
        return getAllCustomHtmlTemplates().find(t => t.id && schemaMatchesTemplate(t, schema) && objectMatchesTemplate(t, obj)) || null;
        }

        function registerUserHtmlTemplateFromTile(tileRoot) {
        setStatus(tileRoot, "HTML templates are server-managed via appsettings.");
        }

        async function resolveCustomHtmlConfig(ctx) {
        const schema = ctx?.res?.schema || ctx?.tileRoot?._state?.dataset?.schema || "";
        const obj = ctx?.res?.obj || ctx?.tileRoot?._state?.dataset?.obj || "";
        const templateId = String(ctx?.tileRoot?._state?.customHtmlTemplate || "").trim();
        const chartType = ctx?.chartType || "customHtml";

        await ensureCustomHtmlTemplatesLoaded();

        if (templateId) {
        const selectedTemplate = getCustomHtmlTemplateById(templateId);
        if (selectedTemplate?.htmlUrl) {
        return {
        found: true,
        key: selectedTemplate.key || selectedTemplate.id,
        schema: selectedTemplate.schema && selectedTemplate.schema !== "*" ? selectedTemplate.schema : schema,
        obj: selectedTemplate.object && selectedTemplate.object !== "*" ? selectedTemplate.object : obj,
        chartType,
        htmlUrl: selectedTemplate.htmlUrl || "",
        connectionName: selectedTemplate.connectionName || "",
        payloadMode: selectedTemplate.payloadMode || "templateAggregate",
        refreshSeconds: Number(selectedTemplate.refreshSeconds || 0) || 0,
        templateId: selectedTemplate.id || selectedTemplate.key || "",
        role: selectedTemplate.role || "",
        rowFields: selectedTemplate.rowFields || [],
        colFields: selectedTemplate.colFields || [],
        valueFields: selectedTemplate.valueFields || [],
        filters: selectedTemplate.filters || {},
        dateGroups: selectedTemplate.dateGroups || {},
        agg: selectedTemplate.agg || "Sum",
        title: selectedTemplate.title || selectedTemplate.label || "",
        icon: selectedTemplate.icon || "",
        trendSchema: selectedTemplate.trendSchema || "",
        trendObject: selectedTemplate.trendObject || "",
        trendDatabase: selectedTemplate.trendDatabase || "",
        trendTimeField: selectedTemplate.trendTimeField || "",
        trendValueField: selectedTemplate.trendValueField || "",
        trendMaxPoints: Number(selectedTemplate.trendMaxPoints || 12) || 12,
        summarySchema: selectedTemplate.summarySchema || "",
        summaryObject: selectedTemplate.summaryObject || "",
        summaryDatabase: selectedTemplate.summaryDatabase || "",
        pointsSchema: selectedTemplate.pointsSchema || "",
        pointsObject: selectedTemplate.pointsObject || "",
        pointsDatabase: selectedTemplate.pointsDatabase || "",
        defaultMode: selectedTemplate.defaultMode || "",
        normalPointsSchema: selectedTemplate.normalPointsSchema || "",
        normalPointsObject: selectedTemplate.normalPointsObject || "",
        normalPointsDatabase: selectedTemplate.normalPointsDatabase || "",
        normalSummarySchema: selectedTemplate.normalSummarySchema || "",
        normalSummaryObject: selectedTemplate.normalSummaryObject || "",
        normalSummaryDatabase: selectedTemplate.normalSummaryDatabase || "",
        fastPointsSchema: selectedTemplate.fastPointsSchema || "",
        fastPointsObject: selectedTemplate.fastPointsObject || "",
        fastPointsDatabase: selectedTemplate.fastPointsDatabase || "",
        fastSummarySchema: selectedTemplate.fastSummarySchema || "",
        fastSummaryObject: selectedTemplate.fastSummaryObject || "",
        fastSummaryDatabase: selectedTemplate.fastSummaryDatabase || ""
        };
        }
        }

        if (!schema || !obj) {
        return { found: false };
        }

        const url = new URL(endpoints.customHtmlConfig, window.location.origin);
        url.searchParams.set("schema", schema);
        url.searchParams.set("obj", obj);
        url.searchParams.set("chartType", chartType);

        return await apiGet(url.toString());
        }



        function isRemoteHealthPayloadMode(config = {}) {
        return String(config?.payloadMode || "").trim().toLowerCase() === "remotehealthmonitor";
        }


        function isAgingForecastPayloadMode(config = {}) {
        return String(config?.payloadMode || "").trim().toLowerCase() === "agingforecastmonitor";
        }

        function buildRawCustomHtmlRequestForDataset(tileRoot, overrides = {}) {
        const req = buildRawCustomHtmlRequest(tileRoot);
        return {
        ...req,
        schema: String(overrides?.schema || req?.schema || "").trim(),
        obj: String(overrides?.obj || req?.obj || "").trim(),
        maxCells: Math.max(250, Number(overrides?.maxCells || req?.maxCells || 50000) || 50000)
        };
        }

        async function fetchCustomHtmlRawDataset(tileRoot, overrides = {}) {
        const req = buildRawCustomHtmlRequestForDataset(tileRoot, overrides);
        if (!req.schema || !req.obj) {
        return { req, res: null, data: [] };
        }

        const res = await apiPost(endpoints.aggregate, req);
        const data = Array.isArray(res?.data) ? res.data.filter(Boolean) : [];
        return { req, res, data };
        }

        function buildAgingForecastModel(summaryRows = [], pointRows = []) {
        function firstValue(row, keys, fallback = null) {
        for (const key of keys) {
        if (row && row[key] !== undefined && row[key] !== null && row[key] !== "") {
        return row[key];
        }
        }
        return fallback;
        }

        function asNumber(value, fallback = null) {
        const n = Number(value);
        return Number.isFinite(n) ? n : fallback;
        }

        function asDateKey(value) {
        return String(value || "")
        .trim()
        .replace("T", " ")
        .replace("Z", "")
        .replace(/\.\d+$/, "");
        }

        const summaryRow = Array.isArray(summaryRows) && summaryRows.length ? summaryRows[0] : {};

        const byDate = new Map();
        for (const sourceRow of (Array.isArray(pointRows) ? pointRows : [])) {
        const rawDate = firstValue(sourceRow, ["PointDate", "pointDate", "point_date", "snapshot_time", "SelectedDate"], "");
        const dateKey = asDateKey(rawDate);
        if (!dateKey) continue;

        const point = {
        PointDate: rawDate,
        Year: asNumber(firstValue(sourceRow, ["Year", "year"]), null),
        MonthNumeric: asNumber(firstValue(sourceRow, ["MonthNumeric", "monthNumeric", "month_numeric"]), null),
        MonthName: firstValue(sourceRow, ["MonthName", "monthName", "month_name"], ""),
        DayOfMonth: asNumber(firstValue(sourceRow, ["DayOfMonth", "dayOfMonth", "day_of_month"]), null),
        DateLabel: firstValue(sourceRow, ["DateLabel", "dateLabel", "date_label"], ""),
        DateHierarchyLabel: firstValue(sourceRow, ["DateHierarchyLabel", "dateHierarchyLabel", "date_hierarchy_label"], ""),
        ActualAmount: asNumber(firstValue(sourceRow, ["ActualAmount", "actualAmount", "actual_amount"]), 0),
        PredictedAmountWithoutS2: asNumber(firstValue(sourceRow, ["PredictedAmountWithoutS2", "predictedAmountWithoutS2", "predicted_amount_without_s2"]), 0),
        PredictedAmountWithS2: asNumber(firstValue(sourceRow, ["PredictedAmountWithS2", "predictedAmountWithS2", "predicted_amount_with_s2"]), 0),
        LowerWithoutS2: asNumber(firstValue(sourceRow, ["LowerWithoutS2", "lowerWithoutS2", "lower_without_s2"]), 0),
        UpperWithoutS2: asNumber(firstValue(sourceRow, ["UpperWithoutS2", "upperWithoutS2", "upper_without_s2"]), 0),
        LowerWithS2: asNumber(firstValue(sourceRow, ["LowerWithS2", "lowerWithS2", "lower_with_s2"]), 0),
        UpperWithS2: asNumber(firstValue(sourceRow, ["UpperWithS2", "upperWithS2", "upper_with_s2"]), 0),
        ConfidenceWithoutS2: asNumber(firstValue(sourceRow, ["ConfidenceWithoutS2", "confidenceWithoutS2", "confidence_without_s2"]), null),
        ConfidenceWithS2: asNumber(firstValue(sourceRow, ["ConfidenceWithS2", "confidenceWithS2", "confidence_with_s2"]), null),
        IsForecast: Number(firstValue(sourceRow, ["IsForecast", "isForecast", "is_forecast"], 0)) === 1 || firstValue(sourceRow, ["IsForecast", "isForecast", "is_forecast"], false) === true,
        IsHoldout: Number(firstValue(sourceRow, ["IsHoldout", "isHoldout", "is_holdout"], 0)) === 1 || firstValue(sourceRow, ["IsHoldout", "isHoldout", "is_holdout"], false) === true,
        HorizonDay: asNumber(firstValue(sourceRow, ["HorizonDay", "horizonDay", "horizon_day"]), 0)
        };

        if (!byDate.has(dateKey)) {
        byDate.set(dateKey, {
        ...point,
        _c0sum: point.ConfidenceWithoutS2 == null ? 0 : point.ConfidenceWithoutS2,
        _c0count: point.ConfidenceWithoutS2 == null ? 0 : 1,
        _c1sum: point.ConfidenceWithS2 == null ? 0 : point.ConfidenceWithS2,
        _c1count: point.ConfidenceWithS2 == null ? 0 : 1
        });
        continue;
        }

        const acc = byDate.get(dateKey);
