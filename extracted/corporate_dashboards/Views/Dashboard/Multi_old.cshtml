        const measures = (agg === "Count") ? ["Count"] : (s?.pivot?.vals || []).filter(Boolean);
        if (ct === "slicer") { const slicerField = (s?.pivot?.rows || []).filter(Boolean)[0] || ""; return slicerField ? `Filter ${slicerField} • ${chartLabel(ct)}` : "Drop exactly one dimension into Rows • Slicer / Dropdown"; }
        if (ct !== "customHtml" && agg !== "Count" && measures.length === 0) return "Drop at least one measure into Values (or use Count)";
        const dims = [].concat(s?.pivot?.rows || []).concat(s?.pivot?.cols || []).filter(Boolean);
        return `${agg} of ${measures.join(", ")}${dims.length ? ` grouped by ${dims.join(", ")}` : ""} • ${chartLabel(ct)}`;
        }
        function buildVizTitle(tileRoot) {
        const manual = (tileRoot?._state?.manualTitle || "").trim();
        return manual || buildAutoVizTitle(tileRoot);
        }
        function refreshTileHeader(tileRoot, force = false) {
        try {
        const el = getEl(tileRoot, "title");
