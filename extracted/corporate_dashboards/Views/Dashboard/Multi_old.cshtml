        saveClose.onclick = () => saveModal.classList.add("d-none");
        saveModal.addEventListener("click", e => { if (e.target === saveModal) saveModal.classList.add("d-none"); });
        saveName.addEventListener("keydown", e => { if (e.key === "Enter") saveConfirm.click(); });
