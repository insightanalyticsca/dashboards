        function esc(s) {
        return String(s ?? '')
        .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;').replaceAll("'", '&#039;');
        }
        const CORP_PAL = (window.DashHtmlVisuals?.palette || ["#0808EE", "#09C698", "#171777", "#c9c9c9", "#d4d4d9", "#BBFF05", "#4F63F7", "#12DDB8", "#635BCB", "#DDF76D"]);
        const AXIS_FONT = 11;

        function emptyHtml(message = "No data") {
        return `<div class="empty">${esc(message)}</div>`;
        }

        function formatHierarchyLabel(value) {
        return window.DashHtmlVisuals?.hierarchyLabel
        ? window.DashHtmlVisuals.hierarchyLabel(value)
        : String(value ?? '');
        }

        function wrapAxisLabel(value, maxChars = 10) {
        const raw = String(formatHierarchyLabel(value) || '').replace(/\n/g, ' ').trim();
        if (!raw) return '';

        // First try to wrap on spaces
        if (raw.includes(' ')) {
        const words = raw.split(/\s+/);
        const lines = [];
        let line = '';

        for (const w of words) {
        const test = line ? (line + ' ' + w) : w;
        if (test.length <= maxChars) {
        line = test;
        } else {
        if (line) lines.push(line);
        line = w;
        }
        }
        if (line) lines.push(line);
        return lines.join('\n');
        }

        // Fallback for labels like APP100 / very long tokens
        const parts = [];
        for (let i = 0; i < raw.length; i += maxChars) {
        parts.push(raw.slice(i, i + maxChars));
        }
        return parts.join('\n');
        }

        function buildEChartsOption(chartType, res, xCats, series, yAxis, extra = {}) {
        const showZoom = xCats.length > 22;
        const wPx = extra.wPx || 600;

        // dynamic font sizes
        const xLabelFs = Math.max(7, Math.min(11, Math.round(wPx / 85)));
        const yLabelFs = Math.max(8, Math.min(12, Math.round(wPx / 75)));

        // optional: if many categories, shrink x labels a bit more
        const xLabelFsAdjusted =
        xCats.length > 28 ? Math.max(7, xLabelFs - 2) :
        xCats.length > 18 ? Math.max(7, xLabelFs - 1) :
        xLabelFs;

        // dynamic wrap width: narrower chart => fewer chars before wrap
        const wrapAt = Math.max(8, Math.min(14, Math.round(wPx / 70)));

        const wrappedCats = xCats.map(v => wrapAxisLabel(v, wrapAt));
        const maxLines = Math.max(1, ...wrappedCats.map(v => String(v).split('\n').length));

        const legendRows = Math.max(1, Math.ceil(series.length / 6));
        const legendTop = 22;
        const legendRowH = 18;
        const gridTop = 44 + (legendRows * legendRowH);

        const lineHeight = xLabelFsAdjusted + 3;
        const baseBottom = showZoom ? 54 : 34;
        const bottom = baseBottom + (maxLines * lineHeight);

        // patch yAxis whether it is object or array
        const patchedYAxis = (Array.isArray(yAxis) ? yAxis : [yAxis]).map(ya => ({
        ...ya,
        axisLabel: {
        ...(ya.axisLabel || {}),
        fontSize: yLabelFs
        }
