        else if (z === "cols") { if (!s.pivot.cols.some(x => x.toLowerCase() === field.toLowerCase())) s.pivot.cols.push(field); if (meta.category === "date" && !s.pivot.dateGroups[field]) s.pivot.dateGroups[field] = "Month"; }
