        }

        function removeFieldFromZone(tileRoot, zone, fieldName) {
        const s = tileRoot._state;
        const pull = arr => { const ix = arr.findIndex(x => x.toLowerCase() === fieldName.toLowerCase()); if (ix >= 0) arr.splice(ix, 1); };
