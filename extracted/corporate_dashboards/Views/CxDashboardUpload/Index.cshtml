@model corporate_dashboards.Models.CxDashboardUploadPageVm
@{
    ViewData["Title"] = "CX Dashboard Upload";
}

<style>
    .cx-upload-shell { max-width: 1180px; margin: 0 auto; }
    .cx-upload-hero {
        border-radius: 22px;
        padding: 28px 30px;
        color: #fff;
        background:
            radial-gradient(circle at 90% 10%, rgba(187,255,5,.32), transparent 28%),
            linear-gradient(135deg, #08083f 0%, #171777 55%, #0909ee 100%);
        box-shadow: 0 18px 45px rgba(10, 16, 80, .22);
    }
    .cx-upload-card {
        border: 1px solid rgba(23,23,119,.14);
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 12px 28px rgba(18, 28, 70, .09);
    }
    .cx-upload-key { font-family: Consolas, monospace; font-size: .78rem; color: #4d5680; }
    .cx-upload-chip {
        display: inline-block;
        padding: .2rem .5rem;
        margin: .1rem .15rem .1rem 0;
        border-radius: 999px;
        background: #f1f3ff;
        color: #171777;
        font-size: .72rem;
    }
    .cx-file-input { min-height: 48px; }
</style>

<div class="cx-upload-shell">
    <section class="cx-upload-hero mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="text-uppercase small fw-semibold opacity-75 mb-2">Manual CX data pipeline</div>
                <h1 class="h3 mb-2">CX Dashboard Upload</h1>
                <p class="mb-0 opacity-75">Upload a filled workbook. Blank tabs and untouched example rows from older templates are ignored.</p>
            </div>
            <a class="btn btn-light fw-semibold" asp-action="Template">
                <i class="fa-solid fa-file-excel me-2"></i>Download empty template
            </a>
        </div>
    </section>

    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger cx-upload-card p-4" role="alert">
            <div class="fw-bold mb-2"><i class="fa-solid fa-circle-xmark me-2"></i>CX upload was not published.</div>
            <ul class="mb-0">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (Model.Success)
    {
        <div class="alert alert-success cx-upload-card p-4" role="status">
            <div class="fw-bold mb-1"><i class="fa-solid fa-circle-check me-2"></i>CX upload published.</div>
            <div>@Model.PublishedRows row(s) from @Model.PublishedVisuals visual tab(s). Batch @Model.UploadBatchId.</div>
        </div>

        <div class="cx-upload-card p-3 mb-4 table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr><th>Sheet</th><th>Visual key</th><th>Pipeline key</th><th class="text-end">Rows</th><th>Status</th></tr>
                </thead>
                <tbody>
                @foreach (var result in Model.Results)
                {
                    <tr>
                        <td>@result.SheetName</td>
                        <td class="cx-upload-key">@result.VisualKey</td>
                        <td class="cx-upload-key">@result.PipelineKey</td>
                        <td class="text-end">@result.RowCount</td>
                        <td><span class="badge text-bg-success">@result.Status</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <section class="cx-upload-card p-4 mb-4">
        <form asp-action="Index" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <label for="uploadFile" class="form-label fw-semibold">Filled CX workbook</label>
            <input id="uploadFile" name="uploadFile" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" class="form-control cx-file-input" required />
            <div class="form-text mt-2">Only configured manual CX sheets are read. API-driven call visuals and Ebill Adoption are excluded.</div>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fa-solid fa-cloud-arrow-up me-2"></i>Validate and publish
                </button>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Back to dashboard</a>
            </div>
        </form>
    </section>

    <section class="cx-upload-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Accepted manual tabs</h2>
            <span class="badge rounded-pill text-bg-light border">@Model.Visuals.Count tabs</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr><th>Sheet</th><th>Visual</th><th>Required fields</th><th>Target view</th></tr>
                </thead>
                <tbody>
                @foreach (var visual in Model.Visuals)
                {
                    <tr>
                        <td class="fw-semibold">@visual.SheetName</td>
                        <td>
                            <div>@visual.Label</div>
                            <div class="cx-upload-key">@visual.Key</div>
                        </td>
                        <td>
                            @foreach (var header in visual.RequiredHeaders)
                            {
                                <span class="cx-upload-chip">@header</span>
                            }
                        </td>
                        <td class="cx-upload-key">@visual.Target</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
