<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>corporate_dashboards</RootNamespace>
    <AssemblyName>corporate_dashboards</AssemblyName>
    <PackageId>corporate_dashboards</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Controllers\DashboardController_old.cs" />
